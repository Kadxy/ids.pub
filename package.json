{
  "name": "ids-pub-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typegen": "wrangler types --strict-vars=false && react-router typegen",
    "typecheck": "bun run typegen && tsc -b",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:sql": "wrangler d1 execute DB --remote --command",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "isbot": "5.2.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vite-plugin": "1.68.0",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.159.0"
  }
}
