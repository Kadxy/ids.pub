{
  "extends": "./tsconfig.json",
  "include": [".react-router/types/**/*", "app/**/*", "workers/**/*", "worker-configuration.d.ts"],
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "resolveJsonModule": true
  }
}
